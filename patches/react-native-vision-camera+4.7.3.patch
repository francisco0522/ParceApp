+package com.mrousavy.camera.core.utils
+
+// ML Kit exposes rawValue only for UTF-8. Legacy PDF417 documents may contain
+// Latin-1 text and binary bytes; preserve each byte without logging the payload.
+internal fun decodeBarcodeValue(rawValue: String?, rawBytes: ByteArray?, isPdf417: Boolean): String? {
+  if (!rawValue.isNullOrEmpty()) {
+    return rawValue
+  }
+  if (!isPdf417 || rawBytes == null || rawBytes.isEmpty()) {
+    return null
+  }
+  return rawBytes.toString(Charsets.ISO_8859_1)
+}
